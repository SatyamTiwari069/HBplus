rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection — only the authenticated owner can read/write their own doc.
    // Additionally only @hbplus.fit emails can ever reach this rule.
    match /users/{userId} {
      allow read, write: if
        request.auth != null &&
        request.auth.uid == userId &&
        request.auth.token.email.matches('.*@hbplus\\.fit$');
    }

    // Admin-only collection example
    match /admin/{docId} {
      allow read, write: if
        request.auth != null &&
        request.auth.token.email == 'admin@hbplus.fit';
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
